# Copy to .env and fill in. run.sh exports every variable in this file before starting the evaluation.

# Judge (gpt-5.6-luna through an OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1      # optional: proxy / gateway

# Directory that contains the local model weights referenced as ${MODELS_DIR}/<model> in configs/*.yaml
MODELS_DIR=/path/to/models

# Optional: restrict the GPUs used by vLLM (default: every GPU reported by nvidia-smi)
# CUDA_VISIBLE_DEVICES=0,1,2,3

# Optional: keys for backend=api models (name them as api.api_key_env in the model config)
# MODEL_API_KEY=...
# MODEL_BASE_URL=https://api.example.com/v1
